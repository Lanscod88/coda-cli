{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "调试: 🐞 cmd-create",
      "program": "${workspaceFolder}/src/bin/index.js",
      "args": ["cmd", "create"],
      "env": {
        "DEBUG_ENV": "true"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "npm: build",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "调试: 🐞 cmd-delete",
      "program": "${workspaceFolder}/src/bin/index.js",
      "args": ["cmd", "delete"],
      "env": {
        "DEBUG_ENV": "true"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "npm: build",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
